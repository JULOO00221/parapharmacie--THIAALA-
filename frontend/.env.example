# URL de l'API Laravel (v1) — utilisée par tous les appels serveur/client
# (lib/api/client.ts) et pour dériver automatiquement le remotePattern
# next/image de production (voir next.config.ts). En développement, elle
# pointe vers l'API locale ; en production, vers le vrai domaine HTTPS de
# l'API (jamais localhost/127.0.0.1).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Origine publique de CE frontend — utilisée par app/layout.tsx
# (metadataBase/OpenGraph), app/sitemap.ts et app/robots.ts pour générer
# des URLs absolues correctes. En production :
# NEXT_PUBLIC_SITE_URL=https://votre-domaine.fr (jamais localhost).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Numéro WhatsApp public de la pharmacie, format international sans « + »
# (ex. 221771234567). Public par nature : affiché sur le site. Vide = les
# boutons WhatsApp renvoient vers le bloc contact du pied de page.
NEXT_PUBLIC_WHATSAPP_NUMBER=
